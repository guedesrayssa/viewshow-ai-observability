@startuml
title Diagrama de Casos de Uso — View Show
left to right direction

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F5F7FB
  BorderColor #233148
  FontColor #172033
}

actor "Usuário\ncorporativo" as Usuario <<abstract>>
actor "Analista de Atendimento\nTécnico N1" as N1
actor "Engenheira de\nSoftware" as Engenharia
actor "Product Manager" as PM
actor "Provedor de\nidentidade / SSO" as SSO

N1 --|> Usuario
Engenharia --|> Usuario
PM --|> Usuario

rectangle "Sistema View Show" {
  usecase "UC-01\nConsultar dashboard" as UC01
  usecase "UC-02\nAutenticar-se" as UC02
  usecase "UC-05\nAnalisar e preparar\nencaminhamento de incidente" as UC05
  usecase "UC-10\nInvestigar falha técnica" as UC10
  usecase "UC-15\nAvaliar recuperação\napós correção" as UC15
  usecase "UC-16\nAnalisar qualidade\nda experiência" as UC16
  usecase "UC-21\nMonitorar saúde\nda telemetria" as UC21
}

Usuario -- UC01
Usuario -- UC02
SSO -- UC02
N1 -- UC05
Engenharia -- UC10
Engenharia -- UC15
Engenharia -- UC21
PM -- UC15
PM -- UC16

UC01 -[hidden]down- UC05
UC05 -[hidden]down- UC10
UC10 -[hidden]down- UC15
UC15 -[hidden]right- UC16
UC16 -[hidden]up- UC21
@enduml
