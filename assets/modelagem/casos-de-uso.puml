@startuml
title Diagrama de Casos de Uso — View Show
left to right direction

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F5F7FB
  BorderColor #233148
  FontColor #172033
}

actor "Usuário\ncorporativo" as Usuario <<abstract>>
actor "Analista de Atendimento\nTécnico N1" as N1
actor "Engenheira de\nSoftware" as Engenharia
actor "Product Manager" as PM
actor "Provedor de\nidentidade / SSO" as SSO

N1 --|> Usuario
Engenharia --|> Usuario
PM --|> Usuario

rectangle "Sistema View Show" {
  usecase "UC-01\nConsultar dashboard" as UC01
  usecase "UC-02\nAutenticar-se" as UC02
  usecase "UC-05\nAnalisar e encaminhar\nincidente" as UC05
  usecase "UC-10\nInvestigar falha técnica" as UC10
  usecase "UC-16\nAnalisar qualidade\nda experiência" as UC16

  note bottom of UC01
    Filtros e exportação são
    passos ou variações do fluxo.
  end note
  note right of UC05
    Priorizar incidentes, consultar
    hipóteses e evidências e preparar
    o resumo compõem o fluxo.
  end note
  note right of UC10
    Validar hipótese, inspecionar
    eventos, comparar períodos e
    verificar recuperação compõem o fluxo.
  end note
  note right of UC16
    Indicadores, segmentos, histórico e
    avaliação após correção compõem o fluxo.
  end note
}

Usuario --> UC01
Usuario --> UC02
SSO --> UC02
N1 --> UC05
Engenharia --> UC10
PM --> UC16

UC01 -[hidden]down- UC05
UC05 -[hidden]down- UC10
UC10 -[hidden]down- UC16
@enduml
