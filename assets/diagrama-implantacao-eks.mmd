%% Diagrama de implantação alvo — migração de ECS/Fargate para EKS/Fargate.
%% É um desenho de planejamento; nenhum recurso EKS é declarado hoje no Terraform.
flowchart LR
    classDef client fill:#F8FAFC,stroke:#475569,color:#0F172A,stroke-width:1px
    classDef edge fill:#E0F2FE,stroke:#0284C7,color:#0C4A6E,stroke-width:1px
    classDef compute fill:#ECFDF5,stroke:#059669,color:#064E3B,stroke-width:1px
    classDef data fill:#FFF7ED,stroke:#EA580C,color:#7C2D12,stroke-width:1px
    classDef control fill:#F5F3FF,stroke:#7C3AED,color:#4C1D95,stroke-width:1px
    classDef external fill:#FEF2F2,stroke:#DC2626,color:#7F1D1D,stroke-width:1px

    user["Usuário"]:::client
    source["Código versionado"]:::client

    subgraph public["Camada pública AWS"]
        amplify["AWS Amplify: frontend Next.js"]:::edge
        gateway["API Gateway: TLS e proxy same-origin"]:::edge
        alb["Application Load Balancer: duas AZs"]:::edge
    end

    subgraph vpc["VPC: sub-redes privadas em duas AZs"]
        subgraph eks["Amazon EKS com perfis Fargate"]
            lbc["AWS Load Balancer Controller"]:::control
            ingress["Ingress API: target type IP"]:::control
            service["Service API: ClusterIP"]:::compute
            api["Deployment API: mínimo 2 Pods; perfis em 2 AZs"]:::compute
            hpa["HPA API: 2 a 4 Pods"]:::control
            cron["CronJob de ingestão"]:::compute
            worker["Deployment worker de análise"]:::compute
            queueScale["KEDA ou HPA com métrica SQS"]:::control
            identity["ServiceAccounts: IRSA por workload"]:::control
        end
        nat["NAT Gateway: saída privada"]:::edge
        endpoints["Endpoints de gateway: S3 e DynamoDB"]:::edge
    end

    subgraph managed["Serviços AWS gerenciados"]
        ecr["Amazon ECR: imagem por digest"]:::data
        dynamo["DynamoDB: operacional e Golden Set"]:::data
        queue["Amazon SQS e DLQ"]:::data
        s3["Amazon S3: histórico e logs"]:::data
        cognito["Amazon Cognito"]:::edge
        cloudwatch["Amazon CloudWatch"]:::data
    end

    argus["Sistema ARGUS: origem operacional"]:::external
    sso["SSO Grupo Globo: OIDC ou SAML"]:::external
    iac["Terraform: VPC, EKS, IAM e ECR"]:::control
    release["Helm ou manifests: workloads"]:::control

    user -->|"HTTPS"| amplify
    amplify -->|"/api, /auth e /health"| gateway
    gateway -->|"HTTP"| alb
    alb -->|"rota do Ingress; targets IP"| service
    service -->|"seleciona"| api
    hpa -. "escala" .-> api
    lbc -. "reconcilia" .-> alb
    lbc -. "observa" .-> ingress
    ingress -. "mapeia" .-> service

    source -->|"build"| ecr
    source -->|"provisiona"| iac
    source -->|"publica"| release
    iac -->|"infraestrutura"| eks
    release -->|"aplica"| api
    release -->|"aplica"| cron
    release -->|"aplica"| worker
    ecr -->|"imagem"| api
    ecr -->|"imagem"| cron
    ecr -->|"imagem"| worker

    identity -. "permissão mínima" .-> api
    identity -. "permissão mínima" .-> cron
    identity -. "permissão mínima" .-> worker
    api -->|"le e grava"| dynamo
    api -->|"autentica"| cognito
    api -. "publica" .-> queue
    queue -. "consome" .-> worker
    queueScale -. "escala" .-> worker
    worker -->|"persiste"| dynamo
    cron -->|"coleta"| argus
    cron -->|"histórico"| s3
    cron -. "envia trabalho" .-> queue
    sso -->|"federação"| cognito
    api -. "logs e métricas" .-> cloudwatch
    cron -. "logs e métricas" .-> cloudwatch
    worker -. "logs e métricas" .-> cloudwatch
