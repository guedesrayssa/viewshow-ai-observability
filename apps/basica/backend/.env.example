# Variáveis de ambiente da API de telemetria.
#
# Copie para `.env` e ajuste. Nada carrega este arquivo automaticamente: para
# usá-lo em uma sessão de terminal, exporte tudo de uma vez com
#
#     set -a; source .env; set +a
#
# Na EC2, os mesmos valores entram como linhas `Environment=` da unit do
# systemd, que é o que garante que a API volte configurada quando a instância
# for reiniciada no começo de cada sessão do laboratório.
#
# Todos os campos têm valor padrão no código; o arquivo existe para tornar
# explícito o que muda entre o ambiente local e o da AWS.

# ---------- Servidor ----------
# Endereço e porta usados apenas pelo servidor embutido (`python app.py`).
# Em produção quem escuta é o gunicorn, configurado na unit do systemd.
HOST=127.0.0.1
PORT=5000

# Console interativo de depuração. Deixe desligado fora do desenvolvimento.
FLASK_DEBUG=0

# ---------- Armazenamento ----------
# `memory` guarda tudo no processo e some a cada reinício — bom para
# desenvolvimento e testes. `dynamodb` persiste na AWS e é o modo usado na EC2.
TELEMETRY_BACKEND=memory

# Nome da tabela criada por `scripts/create_dynamodb_table.py`.
DYNAMODB_TABLE=telemetry

# Região da AWS. No laboratório da AWS Academy, us-east-1.
AWS_REGION=us-east-1

# Endpoint alternativo do DynamoDB, só para apontar ao DynamoDB Local.
# Deixe vazio para falar com a AWS de verdade.
# DYNAMODB_ENDPOINT_URL=http://localhost:8000

# ---------- CORS ----------
# Origens autorizadas a consumir a API pelo navegador, separadas por vírgula.
# `*` libera todas, o que serve localmente. Em produção, use exatamente a URL
# do site estático no S3, sem barra no final.
CORS_ORIGINS=*
# CORS_ORIGINS=http://g05-telemetria-front.s3-website-us-east-1.amazonaws.com
