# Variáveis de ambiente do painel.
#
# Copie para `.env.local` e ajuste. Sem nenhuma delas, o painel roda inteiro
# com o conjunto de exemplo (em desenvolvimento) e declara isso na interface.
#
# O prefixo `NEXT_PUBLIC_` é obrigatório para que o valor chegue ao navegador:
# nada com segredo deve usar esse prefixo.

# API operacional (apps/backend/api, Node/Express): incidentes, evidências,
# hipótese e revisão. Local: http://localhost:3000 — suba o Next em outra
# porta (`next dev -p 3001`).
NEXT_PUBLIC_API_BASE_URL=

# API de telemetria (apps/basica/backend, Flask): QoE, erros, segmentações e
# séries no tempo. Local: http://localhost:5000
NEXT_PUBLIC_TELEMETRY_API_BASE_URL=

# Permite a queda para o conjunto de exemplo quando uma leitura falha.
# O padrão é desligado em qualquer ambiente: sem dado, o painel mostra o
# estado de indisponível com o motivo. Defina "true" apenas para uma
# demonstração deliberada sem backend.
NEXT_PUBLIC_ALLOW_EXAMPLE_DATA=
