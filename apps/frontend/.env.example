# Variáveis de ambiente do painel.
# Copie para `.env.local`. Nunca use NEXT_PUBLIC_ para segredos.

# Único gateway público. Use `/` quando painel e API compartilham a origem.
NEXT_PUBLIC_API_BASE_URL=

# Fixtures são opt-in e apenas para desenvolvimento/testes. Produção ignora
# este valor e sempre mostra indisponibilidade quando não existe dado real.
NEXT_PUBLIC_ALLOW_EXAMPLE_DATA=
