# Runtime identity and telemetry
INGESTION_ENVIRONMENT=local
AWS_REGION=us-east-1
ARGUS_SOURCE_MODE=snapshot
LOG_LEVEL=info
LOG_SERVICE_NAME=view-show-ingestion
METRICS_NAMESPACE=view-show/Ingestion

# Runtime limits
RUN_TTL_SECONDS=7776000
PAGE_SIZE=500
SYNC_MAX_CATCHUP_WINDOWS=96
SYNC_FINALIZATION_DELAY_SECONDS=900
LEASE_TTL_SECONDS=300
OUTBOX_PUBLISH_LIMIT=100
ACTIVATE_CANDIDATE=false
ARCHIVE_WORKDIR=/tmp/ingestion

# Immutable snapshot identity
SNAPSHOT_BUCKET=replace-with-snapshot-bucket
SNAPSHOT_OBJECT_KEY=argus/argus_dump.sql.gz
SNAPSHOT_OBJECT_VERSION_ID=replace-with-version-id
SNAPSHOT_SHA256=replace-with-64-lowercase-hex-digest

# Ephemeral snapshot MySQL sidecar. MYSQL_PASSWORD is injected by ECS Secrets Manager.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
# MYSQL_PASSWORD=<injected-by-ecs-secrets-manager>
MYSQL_DATABASE=argus
MYSQL_CONNECT_TIMEOUT_SECONDS=10
MYSQL_READ_TIMEOUT_SECONDS=300
MYSQL_WRITE_TIMEOUT_SECONDS=300
MYSQL_DDL_TIMEOUT_SECONDS=1800
MYSQL_QUERY_MAX_ATTEMPTS=4
MYSQL_QUERY_RETRY_BASE_MS=250
MYSQL_QUERY_RETRY_MAX_MS=4000
MYSQL_SNAPSHOT_PREPARE_ENABLED=false

# Live MySQL. These five values come from JSON secret keys host/port/username/password/database.
# Enable live commands through the API or a local DynamoDB CONTROL#ARGUS / LIVE_SYNC fixture.
# LIVE_MYSQL_HOST=<injected-from-live-secret-host>
# LIVE_MYSQL_PORT=<injected-from-live-secret-port>
# LIVE_MYSQL_USER=<injected-from-live-secret-username>
# LIVE_MYSQL_PASSWORD=<injected-from-live-secret-password>
# LIVE_MYSQL_DATABASE=<injected-from-live-secret-database>

# Operational stores and publication
OPERATIONAL_TABLE_NAME=view-show-operacional
ARCHIVE_BUCKET=replace-with-archive-bucket
GLUE_DATABASE=g05_s3_ingestion
ATHENA_WORKGROUP=view-show-ingestion
ATHENA_OUTPUT_LOCATION=s3://replace-with-athena-results-bucket/results/
ANALYSIS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/replace-with-queue
