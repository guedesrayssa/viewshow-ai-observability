{
  "family": "monitoracao-api-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::248880318395:role/LabRole",
  "taskRoleArn": "arn:aws:iam::248880318395:role/LabRole",
  "containerDefinitions": [
    {
      "name": "monitoracao-api-container",
      "image": "248880318395.dkr.ecr.us-east-1.amazonaws.com/monitoracao-api:v1",
      "essential": true,
      "portMappings": [{ "containerPort": 3000, "protocol": "tcp" }],
      "environment": [
        { "name": "PORT", "value": "3000" },
        { "name": "AWS_REGION", "value": "us-east-1" },
        { "name": "OPERATIONAL_TABLE_NAME", "value": "monitoracao-operacional" },
        { "name": "MONITORING_SOURCES", "value": "argus" },
        { "name": "AUTH_COOKIE_SECRET", "value": "REPLACE_BEFORE_DEPLOY_openssl_rand_hex_32" },
        { "name": "CURSOR_SECRET", "value": "REPLACE_BEFORE_DEPLOY_openssl_rand_hex_32" },
        { "name": "FRONTEND_ORIGIN", "value": "http://localhost:3001" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/monitoracao-api",
          "awslogs-region": "us-east-1",
          "awslogs-create-group": "true",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
