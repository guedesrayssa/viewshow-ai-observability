  "panels": [
    {
      "id": 1,
      "title": "API AWS — latência p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "rnf-local"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"rnf-api-aws\"}[30s])))",
          "legendFormat": "API — latência p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 2,
      "title": "API AWS — throughput",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "rnf-local"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"rnf-api-aws\"}[30s]))",
          "legendFormat": "API — throughput"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
