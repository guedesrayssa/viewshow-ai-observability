{
  "uid": "rnf-fechamento-aws",
  "title": "RNFs — API e worker AWS (CloudWatch + Prometheus)",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "rnf",
    "local",
    "evidencia"
  ],
  "timezone": "utc",
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
