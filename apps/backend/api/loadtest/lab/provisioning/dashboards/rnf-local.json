{
  "uid": "rnf-fechamento-local",
  "title": "RNFs — execução local real (não AWS)",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["rnf", "local", "evidencia"],
  "timezone": "utc",
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "API — latência p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "rnf-local"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"rnf-api\"}[30s])))",
          "legendFormat": "API — latência p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 2,
      "title": "API — throughput",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "rnf-local"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"rnf-api\"}[30s]))",
          "legendFormat": "API — throughput"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 3,
      "title": "API — erros por segundo",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "rnf-local"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"rnf-api\",status_code=~\"5..\"}[30s])) or vector(0)",
          "legendFormat": "API — erros por segundo"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 4,
      "title": "API — CPU do processo (1 núcleo)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "rnf-local"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * rate(view_show_process_cpu_seconds_total{job=\"rnf-api\"}[30s])",
          "legendFormat": "API — CPU do processo (1 núcleo)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 5,
      "title": "Ingestão local — latência p95 do lote",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "rnf-local"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(rnf_batch_duration_seconds_bucket[1m])))",
          "legendFormat": "Ingestão local — latência p95 do lote"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 6,
      "title": "Ingestão local — eventos persistidos/s",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "rnf-local"
      },
      "gridPos": {
        "x": 6,
        "y": 8,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(rnf_records_written_total[1m])",
          "legendFormat": "Ingestão local — eventos persistidos/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 7,
      "title": "Ingestão local — falhas/s",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "rnf-local"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(rnf_failures_total[1m])",
          "legendFormat": "Ingestão local — falhas/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 8,
      "title": "Ingestão local — CPU do processo (1 núcleo)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "rnf-local"
      },
      "gridPos": {
        "x": 18,
        "y": 8,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * rate(rnf_process_cpu_seconds_total[30s])",
          "legendFormat": "Ingestão local — CPU do processo (1 núcleo)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 9,
      "title": "Ingestão local — backlog de eventos",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "rnf-local"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rnf_backlog_events",
          "legendFormat": "Ingestão local — backlog de eventos"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 10,
      "title": "Ingestão local — eventos oferecidos/s",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "rnf-local"
      },
      "gridPos": {
        "x": 6,
        "y": 16,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(rnf_records_offered_total[1m])",
          "legendFormat": "Ingestão local — eventos oferecidos/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    }
  ]
}
