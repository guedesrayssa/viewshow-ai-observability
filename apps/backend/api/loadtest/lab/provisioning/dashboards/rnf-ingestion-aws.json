{
  "uid": "rnf-ingestion-aws-control",
  "title": "Ingestão AWS — indicadores durante a carga",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "rnf",
    "local",
    "evidencia"
  ],
  "timezone": "utc",
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Latência p95 — API",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "rnf-local"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"rnf-api-aws\",route=~\"/api/v1/imports.*\"}[30s])))",
          "legendFormat": "API — latência p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 2,
      "title": "Throughput — API",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "rnf-local"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"rnf-api-aws\",route=~\"/api/v1/imports.*\"}[30s]))",
          "legendFormat": "API — throughput"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 3,
      "title": "Erros/s — API",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "rnf-local"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"rnf-api-aws\",route=~\"/api/v1/imports.*\",status_code=~\"5..\"}[30s])) or (0 * sum(rate(http_requests_total{job=\"rnf-api-aws\",route=~\"/api/v1/imports.*\"}[30s])))",
          "legendFormat": "API — erros por segundo"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: erros/s",
          "min": 0,
          "custom": {
            "axisSoftMax": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "datasource": {
        "type": "cloudwatch",
        "uid": "rnf-cloudwatch"
      },
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "id": 4,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "rnf-cloudwatch"
          },
          "dimensions": {
            "ClusterName": [
              "view-show-iac-cluster"
            ],
            "TaskDefinitionFamily": "view-show-ingestion-import"
          },
          "hide": true,
          "id": "cpu_used",
          "matchExact": true,
          "metricEditorMode": 0,
          "metricQueryType": 0,
          "metricName": "CpuUtilized",
          "namespace": "ECS/ContainerInsights",
          "period": "300",
          "queryMode": "Metrics",
          "refId": "A",
          "region": "us-east-1",
          "statistic": "Average"
        },
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "rnf-cloudwatch"
          },
          "dimensions": {
            "ClusterName": [
              "view-show-iac-cluster"
            ],
            "TaskDefinitionFamily": "view-show-ingestion-import"
          },
          "hide": true,
          "id": "cpu_reserved",
          "matchExact": true,
          "metricEditorMode": 0,
          "metricQueryType": 0,
          "metricName": "CpuReserved",
          "namespace": "ECS/ContainerInsights",
          "period": "300",
          "queryMode": "Metrics",
          "refId": "B",
          "region": "us-east-1",
          "statistic": "Average"
        },
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "rnf-cloudwatch"
          },
          "expression": "100*cpu_used/cpu_reserved",
          "id": "cpu_percent",
          "label": "CPU utilizada",
          "dimensions": {},
          "metricName": "",
          "namespace": "",
          "period": "300",
          "statistic": "Average",
          "metricEditorMode": 1,
          "metricQueryType": 0,
          "queryMode": "Metrics",
          "refId": "C",
          "region": "us-east-1"
        }
      ],
      "title": "CPU reservada — worker",
      "type": "timeseries"
    }
  ],
  "description": "CG-05 na conta 239162056821/us-east-1: HTTP das rotas /imports (latência, req/s e 5xx/s) e CPU da task import-dump (utilizada/reservada). Mesma janela UTC. Não confundir req/s do controle com eventos/s do processamento. Métricas terminais batch ficam no dashboard complementar."
}
