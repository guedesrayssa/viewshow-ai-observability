# Variáveis dos testes de integração contra a AWS real (IT-AWS-01 a IT-AWS-05),
# lidas por tests/live-aws.integration.test.ts.
#
# Uso: copie para .env.aws.local (ignorado pelo Git), preencha e carregue no shell
# antes de rodar `npm run test:integration:aws`. Nunca versione senhas reais.
#
# As credenciais AWS (sessão do Learner Lab) NÃO entram aqui: o SDK as lê de
# ~/.aws/credentials para acessar o DynamoDB e o S3 diretamente.

# Liga a suíte. Sem "true", os testes são pulados e o `npm test` comum não acessa a AWS.
RUN_LIVE_AWS=true

# URL da API publicada (output `api_url_https` do Terraform em apps/fullstack).
LIVE_AWS_API_URL=

# URL do painel publicado no Amplify (output `painel_url`).
LIVE_AWS_PANEL_URL=

# Usuário de teste criado no Cognito (Seção 3.7, passo 4, de testes-funcionais.md).
LIVE_AWS_USERNAME=

# Senha permanente definida para esse usuário no mesmo passo.
LIVE_AWS_PASSWORD=

# Tabela operacional do DynamoDB (output `tabelas_dynamodb.operacional`).
LIVE_AWS_OPERATIONAL_TABLE=

# Bucket S3 das importações (output `ingestion_runbook.imports.bucket`).
LIVE_AWS_IMPORT_BUCKET=

# Região da stack. Opcional: quando ausente, o teste usa us-east-1.
AWS_REGION=us-east-1
