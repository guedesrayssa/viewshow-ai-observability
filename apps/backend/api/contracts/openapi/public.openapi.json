{
  "openapi": "3.1.0",
  "info": {
    "title": "View Show Operational API",
    "version": "1.0.0",
    "description": "Public gateway contract. DynamoDB physical fields are never public."
  },
  "servers": [{ "url": "/" }],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Cheap liveness check",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status"],
                  "properties": { "status": { "const": "ok" } }
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "operationId": "metrics",
        "responses": {
          "200": {
            "description": "Prometheus metrics",
            "content": { "text/plain": { "schema": { "type": "string" } } }
          },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/auth/login": {
      "get": {
        "operationId": "beginLogin",
        "responses": {
          "302": {
            "description": "Redirect to the configured identity provider",
            "headers": {
              "Location": { "schema": { "type": "string", "format": "uri" } }
            }
          },
          "503": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "operationId": "passwordLogin",
        "description": "Direct username/password login against the Cognito user pool (USER_PASSWORD_AUTH, server-side). Issues the signed session cookie and returns the ID token. Returns FEATURE_UNAVAILABLE when the identity provider is not configured.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["username", "password"],
                "properties": {
                  "username": { "type": "string", "minLength": 1, "maxLength": 320 },
                  "password": { "type": "string", "minLength": 1, "maxLength": 256 }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session issued",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "object",
                          "required": ["token", "tokenType", "expiresInSeconds", "user"],
                          "properties": {
                            "token": { "type": "string" },
                            "tokenType": { "type": "string" },
                            "expiresInSeconds": { "type": "integer" },
                            "user": {
                              "type": "object",
                              "additionalProperties": false,
                              "required": ["id", "name", "email", "role"],
                              "properties": {
                                "id": { "type": "string" },
                                "name": { "type": ["string", "null"] },
                                "email": { "type": "string", "format": "email" },
                                "role": { "type": "string", "enum": ["viewer", "engineer", "admin"] }
                              }
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/auth/callback": {
      "get": {
        "operationId": "completeLogin",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "minLength": 1, "maxLength": 4096 }
          },
          {
            "name": "state",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "minLength": 1, "maxLength": 1024 }
          }
        ],
        "responses": {
          "302": {
            "description": "Session issued and redirect to the overview",
            "headers": {
              "Location": { "schema": { "type": "string" } },
              "Set-Cookie": { "schema": { "type": "string" } }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "responses": { "204": { "description": "Session cleared" } }
      }
    },
    "/auth/session": {
      "get": {
        "operationId": "session",
        "security": [{ "sessionCookie": [] }],
        "responses": {
          "200": {
            "description": "Authenticated session",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/AuthenticatedSession"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/dashboard/overview": {
      "get": {
        "operationId": "dashboardOverview",
        "parameters": [
          { "$ref": "#/components/parameters/Window" },
          { "$ref": "#/components/parameters/DeviceType" },
          { "$ref": "#/components/parameters/Region" },
          { "$ref": "#/components/parameters/AppVersion" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "400": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/incidents": {
      "get": {
        "operationId": "listIncidents",
        "parameters": [
          { "$ref": "#/components/parameters/Window" },
          { "$ref": "#/components/parameters/DeviceType" },
          { "$ref": "#/components/parameters/Region" },
          { "$ref": "#/components/parameters/AppVersion" },
          {
            "name": "cursor",
            "in": "query",
            "schema": { "type": "string", "maxLength": 4096 }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "400": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/incidents/{incidentId}/diagnosis": {
      "get": {
        "operationId": "getDiagnosis",
        "parameters": [{ "$ref": "#/components/parameters/IncidentId" }],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/incidents/{incidentId}/reanalyze": {
      "post": {
        "operationId": "reanalyzeIncident",
        "description": "Requests a manual reanalysis when a publisher is configured. The current deployment returns FEATURE_UNAVAILABLE.",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/IncidentId" },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        ],
        "responses": {
          "202": { "description": "Reanalysis request accepted" },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/incidents/{incidentId}/hypotheses/{hypothesisId}/review": {
      "patch": {
        "operationId": "reviewHypothesis",
        "security": [{ "sessionCookie": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/IncidentId" },
          { "$ref": "#/components/parameters/HypothesisId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ReviewRequest" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/incidents/{incidentId}/events": {
      "get": {
        "operationId": "listIncidentEvents",
        "parameters": [
          { "$ref": "#/components/parameters/IncidentId" },
          { "$ref": "#/components/parameters/Window" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/incidents/{incidentId}/events/{eventId}": {
      "get": {
        "operationId": "getIncidentEvent",
        "description": "Returns 503 until an individual-event source is configured.",
        "parameters": [
          { "$ref": "#/components/parameters/IncidentId" },
          { "$ref": "#/components/parameters/EventId" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/imports": {
      "post": {
        "operationId": "startImport",
        "description": "Starts an import when upload and ingestion infrastructure is configured. The current deployment returns FEATURE_UNAVAILABLE.",
        "security": [{ "sessionCookie": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/StartImportRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Import metadata accepted",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/ImportStartData"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/imports/{importId}/complete": {
      "post": {
        "operationId": "completeImport",
        "description": "Completes a multipart import when ingestion infrastructure is configured. The current deployment returns FEATURE_UNAVAILABLE.",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ImportId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CompleteImportRequest" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Import completion accepted",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/ImportCompleteData"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/imports/{importId}": {
      "get": {
        "operationId": "getImport",
        "description": "Returns import metadata and state when ingestion infrastructure is configured. The current deployment returns FEATURE_UNAVAILABLE.",
        "security": [{ "sessionCookie": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ImportId" }],
        "responses": {
          "200": {
            "description": "Import metadata and state",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/ImportStatusData"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/monitoring/overview": {
      "get": {
        "operationId": "monitoringOverview",
        "parameters": [
          { "$ref": "#/components/parameters/Window" },
          { "name": "source", "in": "query", "schema": { "type": "string" } },
          { "name": "worker", "in": "query", "schema": { "type": "string" } },
          {
            "name": "flowMetric",
            "in": "query",
            "schema": {
              "enum": ["ingestion_rate", "processing_latency", "queue_depth"],
              "default": "processing_latency"
            }
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "400": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Window": {
        "name": "window",
        "in": "query",
        "schema": { "enum": ["15m", "30m", "1h", "6h", "24h"] }
      },
      "DeviceType": {
        "name": "deviceType",
        "in": "query",
        "schema": { "type": "string" }
      },
      "Region": {
        "name": "region",
        "in": "query",
        "schema": { "type": "string" }
      },
      "AppVersion": {
        "name": "appVersion",
        "in": "query",
        "schema": { "type": "string" }
      },
      "IncidentId": {
        "name": "incidentId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "minLength": 1, "maxLength": 256 }
      },
      "HypothesisId": {
        "name": "hypothesisId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "minLength": 1, "maxLength": 256 }
      },
      "EventId": {
        "name": "eventId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "minLength": 1, "maxLength": 256 }
      },
      "ImportId": {
        "name": "importId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session"
      }
    },
    "responses": {
      "Success": {
        "description": "Contract envelope",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/SuccessEnvelope" }
          }
        }
      },
      "Error": {
        "description": "Stable error envelope",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
          }
        }
      }
    },
    "schemas": {
      "Warning": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
      },
      "Freshness": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "observedThrough", "lagSeconds", "state"],
        "properties": {
          "source": { "type": "string" },
          "observedThrough": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "lagSeconds": { "type": ["number", "null"], "minimum": 0 },
          "state": { "enum": ["fresh", "delayed", "partial", "unavailable"] }
        }
      },
      "Meta": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requestId",
          "schemaVersion",
          "generatedAt",
          "window",
          "partial",
          "refreshAfterSeconds",
          "freshness",
          "warnings"
        ],
        "properties": {
          "requestId": { "type": "string" },
          "schemaVersion": { "const": "1.0" },
          "generatedAt": { "type": "string", "format": "date-time" },
          "window": { "type": ["object", "null"] },
          "partial": { "type": "boolean" },
          "refreshAfterSeconds": { "type": ["integer", "null"], "minimum": 1 },
          "freshness": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Freshness" }
          },
          "warnings": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Warning" }
          }
        }
      },
      "SuccessEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "meta"],
        "properties": {
          "data": {},
          "meta": { "$ref": "#/components/schemas/Meta" }
        }
      },
      "AuthenticatedSession": {
        "type": "object",
        "additionalProperties": false,
        "required": ["authenticated", "user"],
        "properties": {
          "authenticated": { "const": true },
          "user": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "email"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": ["string", "null"] },
              "email": { "type": "string", "format": "email" }
            }
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message", "requestId"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "requestId": { "type": "string" },
              "fields": { "type": "array" },
              "details": { "type": "object" }
            }
          }
        }
      },
      "ReviewRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "expectedVersion"],
        "properties": {
          "status": { "enum": ["confirmed", "refuted", "inconclusive"] },
          "note": { "type": ["string", "null"], "maxLength": 1000 },
          "expectedVersion": { "type": "integer", "minimum": 0 }
        }
      },
      "StartImportRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fileName", "sizeBytes", "sha256", "partCount"],
        "properties": {
          "fileName": { "type": "string", "minLength": 1, "maxLength": 255 },
          "sizeBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5497558138880
          },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "partCount": { "type": "integer", "minimum": 1, "maximum": 10000 }
        }
      },
      "CompleteImportRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["parts"],
        "properties": {
          "parts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["partNumber", "etag"],
              "properties": {
                "partNumber": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                },
                "etag": { "type": "string", "minLength": 1, "maxLength": 1024 }
              }
            }
          }
        }
      },
      "ImportStartData": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "fileName", "sizeBytes", "sha256", "partCount"],
        "properties": {
          "id": { "type": "string" },
          "fileName": { "type": "string" },
          "sizeBytes": { "type": "integer" },
          "sha256": { "type": "string" },
          "partCount": { "type": "integer" }
        }
      },
      "ImportCompleteData": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string" },
          "status": { "enum": ["queued"] }
        }
      },
      "ImportStatusData": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "fileName",
          "sizeBytes",
          "sha256",
          "partCount",
          "status"
        ],
        "properties": {
          "id": { "type": "string" },
          "fileName": { "type": "string" },
          "sizeBytes": { "type": "integer" },
          "sha256": { "type": "string" },
          "partCount": { "type": "integer" },
          "status": {
            "enum": [
              "created",
              "uploading",
              "queued",
              "processing",
              "completed",
              "failed"
            ]
          }
        }
      }
    }
  }
}
