{
  "openapi": "3.1.0",
  "info": { "title": "View Show Internal Service APIs", "version": "1.0.0" },
  "security": [{ "internalToken": [] }],
  "paths": {
    "/internal/v1/incidents": {
      "get": {
        "operationId": "internalListIncidents",
        "responses": { "200": { "$ref": "#/components/responses/Internal" } }
      }
    },
    "/internal/v1/incidents/{incidentId}/diagnosis": {
      "get": {
        "operationId": "internalDiagnosis",
        "responses": { "200": { "$ref": "#/components/responses/Internal" } }
      }
    },
    "/internal/v1/incidents/{incidentId}/events": {
      "get": {
        "operationId": "internalEvents",
        "responses": { "200": { "$ref": "#/components/responses/Internal" } }
      }
    },
    "/internal/v1/incidents/{incidentId}/events/{eventId}": {
      "get": {
        "operationId": "internalEvent",
        "responses": { "503": { "description": "Source unavailable" } }
      }
    },
    "/internal/v1/incidents/{incidentId}/hypotheses/{hypothesisId}/review": {
      "patch": {
        "operationId": "internalReview",
        "responses": { "200": { "$ref": "#/components/responses/Internal" } }
      }
    },
    "/internal/v1/dashboard/overview": {
      "get": {
        "operationId": "internalDashboardOverview",
        "responses": { "200": { "$ref": "#/components/responses/Internal" } }
      }
    },
    "/internal/v1/monitoring/overview": {
      "get": {
        "operationId": "internalMonitoringOverview",
        "responses": { "200": { "$ref": "#/components/responses/Internal" } }
      }
    },
    "/internal/v1/auth/login": {
      "post": {
        "operationId": "internalLogin",
        "responses": { "200": { "description": "Session issued" } }
      }
    },
    "/internal/v1/auth/register": {
      "post": {
        "operationId": "internalRegister",
        "responses": { "503": { "description": "Provider unavailable" } }
      }
    },
    "/internal/v1/auth/recover": {
      "post": {
        "operationId": "internalRecover",
        "responses": { "503": { "description": "Provider unavailable" } }
      }
    },
    "/internal/v1/auth/logout": {
      "post": {
        "operationId": "internalLogout",
        "responses": { "204": { "description": "Session cleared" } }
      }
    },
    "/internal/v1/auth/sso": {
      "get": {
        "operationId": "internalSso",
        "responses": { "503": { "description": "Provider unavailable" } }
      }
    },
    "/internal/v1/session": {
      "get": {
        "operationId": "internalSession",
        "responses": {
          "200": { "description": "Identity" },
          "401": { "description": "No valid session" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "internalToken": {
        "type": "apiKey",
        "in": "header",
        "name": "x-internal-token"
      }
    },
    "responses": {
      "Internal": {
        "description": "Internal data and quality context",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/InternalEnvelope" }
          }
        }
      }
    },
    "schemas": {
      "InternalEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "quality"],
        "properties": {
          "data": {},
          "quality": {
            "type": "object",
            "required": [
              "window",
              "partial",
              "refreshAfterSeconds",
              "freshness",
              "warnings"
            ]
          }
        }
      }
    }
  }
}
