PORT=3000
HOST=0.0.0.0
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3001
METRICS_ENABLED=true

# Rate limit por IP (requisições/minuto). 180 é o padrão de produção; suba
# temporariamente numa janela de teste de carga (ver apps/backend/api/loadtest/README.md).
RATE_LIMIT_PER_MINUTE=180

# Limite dedicado por IP para POST /auth/login, mais apertado que o geral
# acima (alvo natural de força bruta/credential stuffing).
AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=10

OTEL_SERVICE_NAME=view-show-api
OTEL_DEPLOYMENT_ENVIRONMENT=local
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOKI_PUSH_URL=http://localhost:3100/loki/api/v1/push

# Versão que aparece em todo log, trace e na métrica view_show_build_info
# (na AWS vem de OTEL_RESOURCE_ATTRIBUTES, preenchido pelo Terraform).
SERVICE_VERSION=local
# Nível mínimo dos logs: info (padrão), warn, error ou silent.
LOG_LEVEL=info
# Requisições mais lentas que isto (ms) saem em warn com slow=true. RNF14: 2000.
SLOW_REQUEST_MS=2000
# Envio de logs ao Loki em lote (valores padrão). Com a API em contêiner coletado
# pelo Alloy, deixe LOKI_PUSH_URL vazio para não duplicar as linhas.
# LOKI_FLUSH_INTERVAL_MS=1000
# LOKI_MAX_BATCH_LINES=500
# LOKI_MAX_BUFFER_LINES=5000

AWS_REGION=us-east-1
OPERATIONAL_TABLE_NAME=view-show-operacional
KUBERNETES_NAMESPACE=view-show
INGESTION_CRONJOB_NAME=ingestion-sync
MONITORING_SOURCES=argus

# Segredos obrigatórios (>= 32 bytes). Gere com: openssl rand -hex 32
AUTH_COOKIE_SECRET=troque-este-segredo-em-producao-32b
CURSOR_SECRET=troque-este-segredo-de-cursor-em-producao
IMPORT_BUCKET=g05-argus-imports
IMPORT_EXPECTED_BUCKET_OWNER=123456789012
# Configure com o mesmo valor de CURSOR_SECRET no deployment.
IMPORT_CURSOR_SECRET=troque-este-segredo-de-cursor-em-producao
IMPORT_KUBERNETES_NAMESPACE=view-show-imports
IMPORT_KUBERNETES_TEMPLATE=ingestion-import
IMPORT_INGESTION_CONTAINER_NAME=ingestion

# Login local por senha: apenas desenvolvimento/teste, recusado em produção.
IDENTITY_DEV_AUTH_ENABLED=false
IDENTITY_DEV_EMAIL=demo@globoplay.com
IDENTITY_DEV_PASSWORD=demo123
IDENTITY_DEV_ROLE=engineer

# SSO/OIDC corporativo (reservado; sem fluxo funcional ainda)
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
