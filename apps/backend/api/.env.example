PORT=3000
HOST=0.0.0.0
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3001
METRICS_ENABLED=true
OTEL_SERVICE_NAME=view-show-api
OTEL_DEPLOYMENT_ENVIRONMENT=local
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOKI_PUSH_URL=http://localhost:3100/loki/api/v1/push

AWS_REGION=us-east-1
OPERATIONAL_TABLE_NAME=monitoracao-operacional
MONITORING_SOURCES=argus

# Segredos obrigatórios (>= 32 bytes). Gere com: openssl rand -hex 32
AUTH_COOKIE_SECRET=troque-este-segredo-em-producao-32b
CURSOR_SECRET=troque-este-segredo-de-cursor-em-producao

# Login local por senha: apenas desenvolvimento/teste, recusado em produção.
IDENTITY_DEV_AUTH_ENABLED=false
IDENTITY_DEV_EMAIL=demo@globoplay.com
IDENTITY_DEV_PASSWORD=demo123
IDENTITY_DEV_ROLE=engineer

