{
  "name": "@viewshow/agentic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Worker assíncrono de análise, modelos determinísticos e diagnóstico A′.",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 dist/tests/",
    "verify": "npm run typecheck && npm run test && npm run test:models",
    "test:integration": "npm run build && node --test --test-concurrency=1 dist/tests/aws-adapters.integration.test.js",
    "test:models": "python3 -m unittest tests/test_training.py tests/test_prepare_argus.py tests/test_pilot_catalog.py",
    "eval:ollama": "npm run build && node dist/scripts/eval-ollama.js",
    "replay:pilot": "npm run build && node dist/scripts/replay-pilot.js",
    "worker": "node dist/src/bootstrap/analysis-worker.js"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1128.0",
    "@aws-sdk/client-dynamodb": "3.1128.0",
    "@aws-sdk/client-s3": "3.1128.0",
    "@aws-sdk/client-sqs": "3.1128.0",
    "@aws-sdk/lib-dynamodb": "3.1128.0"
  }
}
