{
  "name": "@viewshow/agentic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Camada agêntica de análise de causa raiz. Núcleo puro, sem dependências de runtime.",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 dist/tests/*.test.js",
    "verify": "npm run typecheck && npm run test",
    "eval:ollama": "npm run build && node dist/scripts/eval-ollama.js"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.6.0"
  }
}
