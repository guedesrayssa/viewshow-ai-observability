            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "dimensions": {
            "QueueName": [
              "${incremental_queue}"
            ]
          },
          "metricEditorMode": 0,
          "metricQueryType": 0,
          "metricName": "ApproximateAgeOfOldestMessage",
          "namespace": "AWS/SQS",
          "period": "300",
          "queryMode": "Metrics",
          "refId": "B",
          "region": "${aws_region}",
          "statistic": "Maximum"
        },
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "dimensions": {
            "source_mode": [
              "snapshot"
            ]
          },
          "matchExact": false,
          "metricEditorMode": 0,
          "metricQueryType": 0,
          "metricName": "SourceLagSeconds",
          "namespace": "${metrics_namespace}",
          "period": "300",
          "queryMode": "Metrics",
          "refId": "C",
          "region": "${aws_region}",
          "statistic": "Maximum"
        },
        {
