{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "cloudwatch", "uid": "cloudwatch"},
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []},
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}},
      "targets": [
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "dimensions": {"command": "$command"}, "matchExact": false, "metricName": "RunDurationMs", "namespace": "${metrics_namespace}", "period": "300", "queryMode": "Metrics", "refId": "A", "region": "${aws_region}", "statistic": "p95"},
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "dimensions": {"command": "$command"}, "matchExact": false, "metricName": "RunDurationMs", "namespace": "${metrics_namespace}", "period": "300", "queryMode": "Metrics", "refId": "B", "region": "${aws_region}", "statistic": "Maximum"}
      ],
      "title": "Latência da execução — p95 e máximo",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "cloudwatch", "uid": "cloudwatch"},
      "fieldConfig": {"defaults": {"unit": "cps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0},
      "id": 2,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}},
      "targets": [
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "dimensions": {"command": "$command"}, "hide": true, "id": "records_read", "matchExact": false, "metricName": "RecordsRead", "namespace": "${metrics_namespace}", "period": "300", "queryMode": "Metrics", "refId": "A", "region": "${aws_region}", "statistic": "Sum"},
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "dimensions": {"command": "$command"}, "hide": true, "id": "records_written", "matchExact": false, "metricName": "RecordsWritten", "namespace": "${metrics_namespace}", "period": "300", "queryMode": "Metrics", "refId": "B", "region": "${aws_region}", "statistic": "Sum"},
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "expression": "SUM(records_read)/PERIOD(records_read)", "id": "read_rate", "label": "lidos/s", "queryMode": "Metrics", "refId": "C", "region": "${aws_region}"},
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "expression": "SUM(records_written)/PERIOD(records_written)", "id": "write_rate", "label": "escritos/s", "queryMode": "Metrics", "refId": "D", "region": "${aws_region}"}
      ],
      "title": "Throughput — registros/s",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "cloudwatch", "uid": "cloudwatch"},
      "fieldConfig": {"defaults": {"unit": "cps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
      "id": 3,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}},
      "targets": [
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "dimensions": {"command": "$command", "status": "FAILED"}, "hide": true, "id": "failed_runs", "matchExact": false, "metricName": "Runs", "namespace": "${metrics_namespace}", "period": "300", "queryMode": "Metrics", "refId": "A", "region": "${aws_region}", "statistic": "Sum"},
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "dimensions": {"command": "$command", "status": "PARTIAL"}, "hide": true, "id": "partial_runs", "matchExact": false, "metricName": "Runs", "namespace": "${metrics_namespace}", "period": "300", "queryMode": "Metrics", "refId": "B", "region": "${aws_region}", "statistic": "Sum"},
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "dimensions": {"command": "$command"}, "hide": true, "id": "rejected_records", "matchExact": false, "metricName": "RecordsRejected", "namespace": "${metrics_namespace}", "period": "300", "queryMode": "Metrics", "refId": "C", "region": "${aws_region}", "statistic": "Sum"},
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "expression": "(SUM(failed_runs)+SUM(partial_runs))/PERIOD(failed_runs)", "id": "error_rate", "label": "execuções com erro/s", "queryMode": "Metrics", "refId": "D", "region": "${aws_region}"},
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "expression": "SUM(rejected_records)/PERIOD(rejected_records)", "id": "rejection_rate", "label": "registros rejeitados/s", "queryMode": "Metrics", "refId": "E", "region": "${aws_region}"}
      ],
      "title": "Erros por segundo",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "cloudwatch", "uid": "cloudwatch"},
      "fieldConfig": {"defaults": {"max": 100, "min": 0, "unit": "percent"}, "overrides": []},
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
      "id": 4,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}},
      "targets": [
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "dimensions": {"ClusterName": "${cluster_name}", "TaskDefinitionFamily": "$task_family"}, "hide": true, "id": "cpu_used", "matchExact": true, "metricName": "CpuUtilized", "namespace": "ECS/ContainerInsights", "period": "300", "queryMode": "Metrics", "refId": "A", "region": "${aws_region}", "statistic": "Average"},
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "dimensions": {"ClusterName": "${cluster_name}", "TaskDefinitionFamily": "$task_family"}, "hide": true, "id": "cpu_reserved", "matchExact": true, "metricName": "CpuReserved", "namespace": "ECS/ContainerInsights", "period": "300", "queryMode": "Metrics", "refId": "B", "region": "${aws_region}", "statistic": "Average"},
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "expression": "100*cpu_used/cpu_reserved", "id": "cpu_percent", "label": "CPU utilizada", "queryMode": "Metrics", "refId": "C", "region": "${aws_region}"}
      ],
      "title": "CPU da task — utilizada/reservada",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "cloudwatch", "uid": "cloudwatch"},
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 5,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "dimensions": {"command": "$command"}, "matchExact": false, "metricName": "StageDurationMs", "namespace": "${metrics_namespace}", "period": "300", "queryMode": "Metrics", "refId": "A", "region": "${aws_region}", "statistic": "Maximum"}
      ],
      "title": "Duração máxima por etapa",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "cloudwatch", "uid": "cloudwatch"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 6,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "dimensions": {"QueueName": "${analysis_queue}"}, "metricName": "ApproximateAgeOfOldestMessage", "namespace": "AWS/SQS", "period": "300", "queryMode": "Metrics", "refId": "A", "region": "${aws_region}", "statistic": "Maximum"},
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "dimensions": {"QueueName": "${incremental_queue}"}, "metricName": "ApproximateAgeOfOldestMessage", "namespace": "AWS/SQS", "period": "300", "queryMode": "Metrics", "refId": "B", "region": "${aws_region}", "statistic": "Maximum"},
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "dimensions": {"command": "$command"}, "matchExact": false, "metricName": "SourceLagSeconds", "namespace": "${metrics_namespace}", "period": "300", "queryMode": "Metrics", "refId": "C", "region": "${aws_region}", "statistic": "Maximum"},
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "matchExact": false, "metricName": "IncrementalBatchLagSeconds", "namespace": "${metrics_namespace}", "period": "300", "queryMode": "Metrics", "refId": "D", "region": "${aws_region}", "statistic": "Maximum"}
      ],
      "title": "Freshness e idade das filas",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "cloudwatch", "uid": "cloudwatch"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "id": 7,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "dimensions": {"command": "$command"}, "matchExact": false, "metricName": "RecordsRead", "namespace": "${metrics_namespace}", "period": "300", "queryMode": "Metrics", "refId": "A", "region": "${aws_region}", "statistic": "Sum"},
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "dimensions": {"command": "$command"}, "matchExact": false, "metricName": "RecordsWritten", "namespace": "${metrics_namespace}", "period": "300", "queryMode": "Metrics", "refId": "B", "region": "${aws_region}", "statistic": "Sum"},
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "dimensions": {"command": "$command"}, "matchExact": false, "metricName": "RecordsUnchanged", "namespace": "${metrics_namespace}", "period": "300", "queryMode": "Metrics", "refId": "C", "region": "${aws_region}", "statistic": "Sum"},
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "dimensions": {"command": "$command"}, "matchExact": false, "metricName": "SchemaDrift", "namespace": "${metrics_namespace}", "period": "300", "queryMode": "Metrics", "refId": "D", "region": "${aws_region}", "statistic": "Sum"},
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "dimensions": {"command": "$command"}, "matchExact": false, "metricName": "RecordsRejected", "namespace": "${metrics_namespace}", "period": "300", "queryMode": "Metrics", "refId": "E", "region": "${aws_region}", "statistic": "Sum"},
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "matchExact": false, "metricName": "IncrementalBatchQuarantined", "namespace": "${metrics_namespace}", "period": "300", "queryMode": "Metrics", "refId": "F", "region": "${aws_region}", "statistic": "Sum"},
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "dimensions": {"QueueName": "${analysis_dlq}"}, "metricName": "ApproximateNumberOfMessagesVisible", "namespace": "AWS/SQS", "period": "300", "queryMode": "Metrics", "refId": "G", "region": "${aws_region}", "statistic": "Maximum"},
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "dimensions": {"QueueName": "${incremental_dlq}"}, "metricName": "ApproximateNumberOfMessagesVisible", "namespace": "AWS/SQS", "period": "300", "queryMode": "Metrics", "refId": "H", "region": "${aws_region}", "statistic": "Maximum"}
      ],
      "title": "Reconciliação, qualidade de dados e DLQs",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "cloudwatch", "uid": "cloudwatch"},
      "gridPos": {"h": 10, "w": 12, "x": 12, "y": 16},
      "id": 8,
      "options": {"enableLogDetails": true, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true},
      "targets": [
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "expression": "fields @timestamp, @message | filter @message like /ingestion\\.(run|stage)\\.(started|finished|failed|partial)/ | sort @timestamp desc | limit 100", "logGroups": [{"arn": "arn:aws:logs:${aws_region}:${account_id}:log-group:${backfill_log_group}:*", "name": "${backfill_log_group}"}, {"arn": "arn:aws:logs:${aws_region}:${account_id}:log-group:${sync_log_group}:*", "name": "${sync_log_group}"}, {"arn": "arn:aws:logs:${aws_region}:${account_id}:log-group:${incremental_export_log_group}:*", "name": "${incremental_export_log_group}"}, {"arn": "arn:aws:logs:${aws_region}:${account_id}:log-group:${incremental_ingest_log_group}:*", "name": "${incremental_ingest_log_group}"}], "queryMode": "Logs", "refId": "A", "region": "${aws_region}"}
      ],
      "title": "Eventos operacionais da ingestão",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["view-show", "aws", "ingestion"],
  "templating": {"list": [
    {"current": {"selected": true, "text": "backfill", "value": "backfill"}, "hide": 0, "includeAll": false, "label": "Comando", "multi": false, "name": "command", "options": [{"selected": true, "text": "backfill", "value": "backfill"}, {"selected": false, "text": "sync", "value": "sync"}, {"selected": false, "text": "export-incremental", "value": "export-incremental"}, {"selected": false, "text": "ingest-incremental", "value": "ingest-incremental"}], "query": "backfill,sync,export-incremental,ingest-incremental", "type": "custom"},
    {"current": {"selected": true, "text": "${backfill_task_family}", "value": "${backfill_task_family}"}, "hide": 0, "includeAll": false, "label": "Task ECS", "multi": false, "name": "task_family", "options": [{"selected": true, "text": "${backfill_task_family}", "value": "${backfill_task_family}"}, {"selected": false, "text": "${sync_task_family}", "value": "${sync_task_family}"}, {"selected": false, "text": "${incremental_export_task_family}", "value": "${incremental_export_task_family}"}, {"selected": false, "text": "${incremental_ingest_task_family}", "value": "${incremental_ingest_task_family}"}], "query": "${backfill_task_family},${sync_task_family},${incremental_export_task_family},${incremental_ingest_task_family}", "type": "custom"}
  ]},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "View Show — Ingestão",
  "uid": "view-show-ingestion",
  "version": 1
}
