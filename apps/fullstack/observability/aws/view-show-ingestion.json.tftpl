    },
    {
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "id": 8,
      "options": {
        "enableLogDetails": true,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "expression": "fields @timestamp, @message | filter kubernetes.namespace_name = '$workload_namespace' | filter @message like /ingestion.run./ | sort @timestamp desc | limit 100",
          "logGroups": [
            {
              "arn": "arn:aws:logs:${aws_region}:${account_id}:log-group:${log_group}:*",
              "name": "${log_group}"
            }
          ],
          "queryMode": "Logs",
          "refId": "A",
          "region": "${aws_region}"
        }
      ],
      "title": "Eventos operacionais da ingestão",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": [
    "view-show",
    "aws",
    "ingestion"
  ],
  "templating": {
    "list": [
      {
        "name": "operation",
        "label": "Operação (métricas EMF)",
        "type": "custom",
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "current": {
          "selected": true,
          "text": "backfill",
          "value": "backfill"
        },
        "options": [
          {
            "selected": true,
            "text": "backfill",
            "value": "backfill"
          },
          {
            "selected": false,
            "text": "import-dump",
            "value": "import-dump"
          },
          {
            "selected": false,
            "text": "sync",
            "value": "sync"
          },
          {
            "selected": false,
            "text": "export-incremental",
            "value": "export-incremental"
          },
          {
            "selected": false,
            "text": "ingest-incremental",
            "value": "ingest-incremental"
          }
        ],
        "query": "backfill,import-dump,sync,export-incremental,ingest-incremental"
      },
      {
        "name": "workload_namespace",
        "label": "Namespace (CPU/logs)",
        "type": "custom",
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "current": {
          "selected": true,
          "text": "${namespace}",
          "value": "${namespace}"
        },
        "options": [
          {
            "selected": true,
            "text": "${namespace}",
            "value": "${namespace}"
          },
          {
            "selected": false,
            "text": "${imports_namespace}",
            "value": "${imports_namespace}"
          }
        ],
        "query": "${namespace},${imports_namespace}"
      },
      {
        "name": "pod",
        "label": "Pod da operação",
        "type": "query",
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "refresh": 2,
        "datasource": {
          "type": "cloudwatch",
          "uid": "cloudwatch"
        },
        "query": {
          "queryType": "dimensionValues",
          "region": "${aws_region}",
          "namespace": "ContainerInsights",
          "metricName": "pod_cpu_utilization_over_pod_limit",
          "dimensionKey": "PodName",
          "dimensionFilters": {
            "ClusterName": "${cluster_name}",
            "Namespace": "$workload_namespace"
          },
          "refId": "CloudWatchVariableQueryEditor-VariableQuery"
        },
        "options": []
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "View Show — Ingestão",
  "uid": "view-show-ingestion",
  "version": 1
}
