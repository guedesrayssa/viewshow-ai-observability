{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "cloudwatch", "uid": "cloudwatch"},
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []},
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}},
      "targets": [
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "dimensions": {"command": "$${operation:text}"}, "label": "execução p95", "matchExact": false, "metricEditorMode": 0, "metricQueryType": 0, "metricName": "RunDurationMs", "namespace": "${metrics_namespace}", "period": "300", "queryMode": "Metrics", "refId": "A", "region": "${aws_region}", "statistic": "p95"},
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "dimensions": {"command": "$${operation:text}", "stage": ["PROJECTING"]}, "label": "projeção máxima", "matchExact": true, "metricEditorMode": 0, "metricQueryType": 0, "metricName": "StageDurationMs", "namespace": "${metrics_namespace}", "period": "300", "queryMode": "Metrics", "refId": "B", "region": "${aws_region}", "statistic": "Maximum"}
      ],
      "title": "Latência — execução p95 e projeção máxima",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "cloudwatch", "uid": "cloudwatch"},
      "fieldConfig": {"defaults": {"unit": "cps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0},
      "id": 2,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}},
      "targets": [
        {"datasource":{"type":"cloudwatch","uid":"cloudwatch"},"dimensions":{"command":"$${operation:text}"},"hide":true,"id":"records_read","matchExact":false,"metricEditorMode":0,"metricQueryType":0,"metricName":"RecordsRead","namespace":"${metrics_namespace}","period":"300","queryMode":"Metrics","refId":"A","region":"${aws_region}","statistic":"Sum"},
        {"datasource":{"type":"cloudwatch","uid":"cloudwatch"},"dimensions":{"command":"$${operation:text}"},"hide":true,"id":"records_written","matchExact":false,"metricEditorMode":0,"metricQueryType":0,"metricName":"RecordsWritten","namespace":"${metrics_namespace}","period":"300","queryMode":"Metrics","refId":"B","region":"${aws_region}","statistic":"Sum"},
        {"datasource":{"type":"cloudwatch","uid":"cloudwatch"},"expression":"SUM(records_read)/300","id":"read_rate","label":"lidos/s","dimensions":{},"metricName":"","namespace":"","period":"300","statistic":"Average","metricEditorMode":1,"metricQueryType":0,"queryMode":"Metrics","refId":"C","region":"${aws_region}"},
        {"datasource":{"type":"cloudwatch","uid":"cloudwatch"},"expression":"SUM(records_written)/300","id":"write_rate","label":"escritos/s","dimensions":{},"metricName":"","namespace":"","period":"300","statistic":"Average","metricEditorMode":1,"metricQueryType":0,"queryMode":"Metrics","refId":"D","region":"${aws_region}"}
      ],
      "title": "Throughput — registros/s",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "cloudwatch", "uid": "cloudwatch"},
      "fieldConfig": {"defaults": {"unit": "cps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
      "id": 3,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}},
      "targets": [
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "dimensions": {"command": "$${operation:text}", "status": ["FAILED"]}, "hide": true, "id": "failed_runs", "matchExact": false, "metricEditorMode": 0, "metricQueryType": 0, "metricName": "Runs", "namespace": "${metrics_namespace}", "period": "300", "queryMode": "Metrics", "refId": "A", "region": "${aws_region}", "statistic": "Sum"},
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "dimensions": {"command": "$${operation:text}", "status": ["PARTIAL"]}, "hide": true, "id": "partial_runs", "matchExact": false, "metricEditorMode": 0, "metricQueryType": 0, "metricName": "Runs", "namespace": "${metrics_namespace}", "period": "300", "queryMode": "Metrics", "refId": "B", "region": "${aws_region}", "statistic": "Sum"},
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "dimensions": {"command": "$${operation:text}"}, "hide": true, "id": "rejected_records", "matchExact": false, "metricEditorMode": 0, "metricQueryType": 0, "metricName": "RecordsRejected", "namespace": "${metrics_namespace}", "period": "300", "queryMode": "Metrics", "refId": "C", "region": "${aws_region}", "statistic": "Sum"},
        {"datasource":{"type":"cloudwatch","uid":"cloudwatch"},"expression":"(SUM(failed_runs)+SUM(partial_runs))/300","id":"error_rate","label":"execuções com erro/s","dimensions":{},"metricName":"","namespace":"","period":"300","statistic":"Average","metricEditorMode":1,"metricQueryType":0,"queryMode":"Metrics","refId":"D","region":"${aws_region}"},
        {"datasource":{"type":"cloudwatch","uid":"cloudwatch"},"expression":"SUM(rejected_records)/300","id":"rejection_rate","label":"registros rejeitados/s","dimensions":{},"metricName":"","namespace":"","period":"300","statistic":"Average","metricEditorMode":1,"metricQueryType":0,"queryMode":"Metrics","refId":"E","region":"${aws_region}"}
      ],
      "title": "Erros por segundo",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "cloudwatch", "uid": "cloudwatch"},
      "fieldConfig": {"defaults": {"max": 100, "min": 0, "unit": "percent"}, "overrides": []},
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
      "id": 4,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}},
      "targets": [
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "dimensions": {"ClusterName": ["${cluster_name}"], "TaskDefinitionFamily": "$operation"}, "hide": true, "id": "cpu_used", "matchExact": true, "metricEditorMode": 0, "metricQueryType": 0, "metricName": "CpuUtilized", "namespace": "ECS/ContainerInsights", "period": "300", "queryMode": "Metrics", "refId": "A", "region": "${aws_region}", "statistic": "Average"},
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "dimensions": {"ClusterName": ["${cluster_name}"], "TaskDefinitionFamily": "$operation"}, "hide": true, "id": "cpu_reserved", "matchExact": true, "metricEditorMode": 0, "metricQueryType": 0, "metricName": "CpuReserved", "namespace": "ECS/ContainerInsights", "period": "300", "queryMode": "Metrics", "refId": "B", "region": "${aws_region}", "statistic": "Average"},
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "expression": "100*cpu_used/cpu_reserved", "id": "cpu_percent", "label": "CPU utilizada", "dimensions":{},"metricName":"","namespace":"","period":"300","statistic":"Average","metricEditorMode":1,"metricQueryType":0, "queryMode": "Metrics", "refId": "C", "region": "${aws_region}"}
      ],
      "title": "CPU da task — utilizada/reservada",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "cloudwatch", "uid": "cloudwatch"},
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 5,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "dimensions": {"command": "$${operation:text}", "stage": ["STARTING"]}, "matchExact": true, "metricEditorMode": 0, "metricQueryType": 0, "metricName": "StageDurationMs", "namespace": "${metrics_namespace}", "period": "300", "queryMode": "Metrics", "refId": "A", "region": "${aws_region}", "statistic": "Maximum"},
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "dimensions": {"command": "$${operation:text}", "stage": ["RESTORING"]}, "matchExact": true, "metricEditorMode": 0, "metricQueryType": 0, "metricName": "StageDurationMs", "namespace": "${metrics_namespace}", "period": "300", "queryMode": "Metrics", "refId": "B", "region": "${aws_region}", "statistic": "Maximum"},
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "dimensions": {"command": "$${operation:text}", "stage": ["VALIDATING"]}, "matchExact": true, "metricEditorMode": 0, "metricQueryType": 0, "metricName": "StageDurationMs", "namespace": "${metrics_namespace}", "period": "300", "queryMode": "Metrics", "refId": "C", "region": "${aws_region}", "statistic": "Maximum"},
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "dimensions": {"command": "$${operation:text}", "stage": ["INGESTING"]}, "matchExact": true, "metricEditorMode": 0, "metricQueryType": 0, "metricName": "StageDurationMs", "namespace": "${metrics_namespace}", "period": "300", "queryMode": "Metrics", "refId": "D", "region": "${aws_region}", "statistic": "Maximum"},
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "dimensions": {"command": "$${operation:text}", "stage": ["PROJECTING"]}, "label": "projeção máxima", "matchExact": true, "metricEditorMode": 0, "metricQueryType": 0, "metricName": "StageDurationMs", "namespace": "${metrics_namespace}", "period": "300", "queryMode": "Metrics", "refId": "E", "region": "${aws_region}", "statistic": "Maximum"}
      ],
      "title": "Duração máxima por etapa",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "cloudwatch", "uid": "cloudwatch"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 6,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "dimensions": {"QueueName": ["${analysis_queue}"]}, "metricEditorMode": 0, "metricQueryType": 0, "metricName": "ApproximateAgeOfOldestMessage", "namespace": "AWS/SQS", "period": "300", "queryMode": "Metrics", "refId": "A", "region": "${aws_region}", "statistic": "Maximum"},
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "dimensions": {"QueueName": ["${incremental_queue}"]}, "metricEditorMode": 0, "metricQueryType": 0, "metricName": "ApproximateAgeOfOldestMessage", "namespace": "AWS/SQS", "period": "300", "queryMode": "Metrics", "refId": "B", "region": "${aws_region}", "statistic": "Maximum"},
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "dimensions": {"source_mode": ["snapshot"]}, "matchExact": false, "metricEditorMode": 0, "metricQueryType": 0, "metricName": "SourceLagSeconds", "namespace": "${metrics_namespace}", "period": "300", "queryMode": "Metrics", "refId": "C", "region": "${aws_region}", "statistic": "Maximum"},
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "matchExact": false, "metricEditorMode": 0, "metricQueryType": 0, "metricName": "IncrementalBatchLagSeconds", "namespace": "${metrics_namespace}", "period": "300", "queryMode": "Metrics", "refId": "D", "region": "${aws_region}", "statistic": "Maximum"}
      ],
      "title": "Freshness e idade das filas",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "cloudwatch", "uid": "cloudwatch"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "id": 7,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "dimensions": {"command": "$${operation:text}"}, "matchExact": false, "metricEditorMode": 0, "metricQueryType": 0, "metricName": "RecordsRead", "namespace": "${metrics_namespace}", "period": "300", "queryMode": "Metrics", "refId": "A", "region": "${aws_region}", "statistic": "Sum"},
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "dimensions": {"command": "$${operation:text}"}, "matchExact": false, "metricEditorMode": 0, "metricQueryType": 0, "metricName": "RecordsWritten", "namespace": "${metrics_namespace}", "period": "300", "queryMode": "Metrics", "refId": "B", "region": "${aws_region}", "statistic": "Sum"},
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "dimensions": {"command": "$${operation:text}"}, "matchExact": false, "metricEditorMode": 0, "metricQueryType": 0, "metricName": "RecordsUnchanged", "namespace": "${metrics_namespace}", "period": "300", "queryMode": "Metrics", "refId": "C", "region": "${aws_region}", "statistic": "Sum"},
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "dimensions": {"command": "$${operation:text}"}, "matchExact": false, "metricEditorMode": 0, "metricQueryType": 0, "metricName": "SchemaDrift", "namespace": "${metrics_namespace}", "period": "300", "queryMode": "Metrics", "refId": "D", "region": "${aws_region}", "statistic": "Sum"},
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "dimensions": {"command": "$${operation:text}"}, "matchExact": false, "metricEditorMode": 0, "metricQueryType": 0, "metricName": "RecordsRejected", "namespace": "${metrics_namespace}", "period": "300", "queryMode": "Metrics", "refId": "E", "region": "${aws_region}", "statistic": "Sum"},
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "matchExact": false, "metricEditorMode": 0, "metricQueryType": 0, "metricName": "IncrementalBatchQuarantined", "namespace": "${metrics_namespace}", "period": "300", "queryMode": "Metrics", "refId": "F", "region": "${aws_region}", "statistic": "Sum"},
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "dimensions": {"QueueName": ["${analysis_dlq}"]}, "metricEditorMode": 0, "metricQueryType": 0, "metricName": "ApproximateNumberOfMessagesVisible", "namespace": "AWS/SQS", "period": "300", "queryMode": "Metrics", "refId": "G", "region": "${aws_region}", "statistic": "Maximum"},
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "dimensions": {"QueueName": ["${incremental_dlq}"]}, "metricEditorMode": 0, "metricQueryType": 0, "metricName": "ApproximateNumberOfMessagesVisible", "namespace": "AWS/SQS", "period": "300", "queryMode": "Metrics", "refId": "H", "region": "${aws_region}", "statistic": "Maximum"}
      ],
      "title": "Reconciliação, qualidade de dados e DLQs",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "cloudwatch", "uid": "cloudwatch"},
      "gridPos": {"h": 10, "w": 12, "x": 12, "y": 16},
      "id": 8,
      "options": {"enableLogDetails": true, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true},
      "targets": [
        {"datasource": {"type": "cloudwatch", "uid": "cloudwatch"}, "expression": "fields @timestamp, @message | filter @message like /ingestion.run./ | sort @timestamp desc | limit 100", "logGroups": [{"arn": "arn:aws:logs:${aws_region}:${account_id}:log-group:${backfill_log_group}:*", "name": "${backfill_log_group}"}, {"arn": "arn:aws:logs:${aws_region}:${account_id}:log-group:${sync_log_group}:*", "name": "${sync_log_group}"}, {"arn": "arn:aws:logs:${aws_region}:${account_id}:log-group:${incremental_export_log_group}:*", "name": "${incremental_export_log_group}"}, {"arn": "arn:aws:logs:${aws_region}:${account_id}:log-group:${incremental_ingest_log_group}:*", "name": "${incremental_ingest_log_group}"}], "queryMode": "Logs", "refId": "A", "region": "${aws_region}"}
      ],
      "title": "Eventos operacionais da ingestão",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["view-show", "aws", "ingestion"],
  "templating": {"list": [
    {
      "current": {"selected": true, "text": "backfill", "value": "${backfill_task_family}"},
      "hide": 0,
      "includeAll": false,
      "label": "Operação",
      "multi": false,
      "name": "operation",
      "options": [
        {"selected": true, "text": "backfill", "value": "${backfill_task_family}"},
        {"selected": false, "text": "sync", "value": "${sync_task_family}"},
        {"selected": false, "text": "export-incremental", "value": "${incremental_export_task_family}"},
        {"selected": false, "text": "ingest-incremental", "value": "${incremental_ingest_task_family}"}
      ],
      "query": "backfill : ${backfill_task_family},sync : ${sync_task_family},export-incremental : ${incremental_export_task_family},ingest-incremental : ${incremental_ingest_task_family}",
      "type": "custom"
    }
  ]},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "View Show — Ingestão",
  "uid": "view-show-ingestion",
  "version": 1
}
