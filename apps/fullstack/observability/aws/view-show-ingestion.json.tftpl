{
  "annotations": {
    "list": []
  },
  "editable": false,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "dimensions": {
            "command": "$${operation:text}"
          },
          "label": "execução p95",
          "matchExact": false,
          "metricEditorMode": 0,
          "metricQueryType": 0,
          "metricName": "RunDurationMs",
          "namespace": "${metrics_namespace}",
          "period": "300",
          "queryMode": "Metrics",
          "refId": "A",
          "region": "${aws_region}",
          "statistic": "p95"
        },
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "dimensions": {
            "command": "$${operation:text}",
            "stage": [
              "PROJECTING"
            ]
          },
          "label": "projeção máxima",
          "matchExact": true,
          "metricEditorMode": 0,
          "metricQueryType": 0,
          "metricName": "StageDurationMs",
          "namespace": "${metrics_namespace}",
          "period": "300",
          "queryMode": "Metrics",
          "refId": "B",
          "region": "${aws_region}",
          "statistic": "Maximum"
        }
      ],
      "title": "Latência — execução p95 e projeção máxima",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "dimensions": {
            "command": "$${operation:text}"
          },
          "hide": true,
          "id": "records_read",
          "matchExact": false,
          "metricEditorMode": 0,
          "metricQueryType": 0,
          "metricName": "RecordsRead",
          "namespace": "${metrics_namespace}",
          "period": "300",
          "queryMode": "Metrics",
          "refId": "A",
          "region": "${aws_region}",
          "statistic": "Sum"
        },
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "dimensions": {
            "command": "$${operation:text}"
          },
          "hide": true,
          "id": "records_written",
          "matchExact": false,
          "metricEditorMode": 0,
          "metricQueryType": 0,
          "metricName": "RecordsWritten",
          "namespace": "${metrics_namespace}",
          "period": "300",
          "queryMode": "Metrics",
          "refId": "B",
          "region": "${aws_region}",
          "statistic": "Sum"
        },
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "expression": "SUM(records_read)/300",
          "id": "read_rate",
          "label": "lidos/s",
          "dimensions": {},
          "metricName": "",
          "namespace": "",
          "period": "300",
          "statistic": "Average",
          "metricEditorMode": 1,
          "metricQueryType": 0,
          "queryMode": "Metrics",
          "refId": "C",
          "region": "${aws_region}"
        },
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "expression": "SUM(records_written)/300",
          "id": "write_rate",
          "label": "escritos/s",
          "dimensions": {},
          "metricName": "",
          "namespace": "",
          "period": "300",
          "statistic": "Average",
          "metricEditorMode": 1,
          "metricQueryType": 0,
          "queryMode": "Metrics",
          "refId": "D",
          "region": "${aws_region}"
        }
      ],
      "title": "Throughput — registros/s",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "dimensions": {
            "command": "$${operation:text}",
            "status": [
              "FAILED"
            ]
          },
          "hide": true,
          "id": "failed_runs",
          "matchExact": false,
          "metricEditorMode": 0,
          "metricQueryType": 0,
          "metricName": "Runs",
          "namespace": "${metrics_namespace}",
          "period": "300",
          "queryMode": "Metrics",
          "refId": "A",
          "region": "${aws_region}",
          "statistic": "Sum"
        },
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "dimensions": {
            "command": "$${operation:text}",
            "status": [
              "PARTIAL"
            ]
          },
          "hide": true,
          "id": "partial_runs",
          "matchExact": false,
          "metricEditorMode": 0,
          "metricQueryType": 0,
          "metricName": "Runs",
          "namespace": "${metrics_namespace}",
          "period": "300",
          "queryMode": "Metrics",
          "refId": "B",
          "region": "${aws_region}",
          "statistic": "Sum"
        },
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "dimensions": {
            "command": "$${operation:text}"
          },
          "hide": true,
          "id": "rejected_records",
          "matchExact": false,
          "metricEditorMode": 0,
          "metricQueryType": 0,
          "metricName": "RecordsRejected",
          "namespace": "${metrics_namespace}",
          "period": "300",
          "queryMode": "Metrics",
          "refId": "C",
          "region": "${aws_region}",
          "statistic": "Sum"
        },
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "expression": "(SUM(failed_runs)+SUM(partial_runs))/300",
          "id": "error_rate",
          "label": "execuções com erro/s",
          "dimensions": {},
          "metricName": "",
          "namespace": "",
          "period": "300",
          "statistic": "Average",
          "metricEditorMode": 1,
          "metricQueryType": 0,
          "queryMode": "Metrics",
          "refId": "D",
          "region": "${aws_region}"
        },
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "expression": "SUM(rejected_records)/300",
          "id": "rejection_rate",
          "label": "registros rejeitados/s",
          "dimensions": {},
          "metricName": "",
          "namespace": "",
          "period": "300",
          "statistic": "Average",
          "metricEditorMode": 1,
          "metricQueryType": 0,
          "queryMode": "Metrics",
          "refId": "E",
          "region": "${aws_region}"
        }
      ],
      "title": "Erros por segundo",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 4,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch"
          },
          "dimensions": {
            "ClusterName": "${cluster_name}",
            "Namespace": "$workload_namespace",
            "PodName": "$pod"
          },
          "matchExact": true,
          "metricEditorMode": 0,
          "metricQueryType": 0,
          "metricName": "pod_cpu_utilization_over_pod_limit",
          "namespace": "ContainerInsights",
          "period": "60",
          "queryMode": "Metrics",
          "refId": "A",
          "region": "${aws_region}",
          "statistic": "Average",
          "label": "CPU do Pod / limite"
        }
      ],
      "title": "CPU do Pod EKS — % do limite",
      "type": "timeseries",
      "description": "Selecione Namespace/Pod da operação e a mesma janela. Inclui containers do Pod; sem limites de CPU a métrica pode faltar."
    },
    {
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch"
      },
      "fieldConfig": {
