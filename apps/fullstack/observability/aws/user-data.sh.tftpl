#!/bin/bash
set -euo pipefail

STACK_DIR=/opt/view-show-observability
COMPOSE_VERSION=v2.39.4
COMPOSE_SHA256=7af95166a730b87e172d4fc9aefea8725d3c6c7327d59149267b452114ddb7d4

dnf install -y docker gzip
systemctl enable --now docker

install -d -m 0755 /usr/local/lib/docker/cli-plugins
curl --fail --silent --show-error --location \
  "https://github.com/docker/compose/releases/download/$${COMPOSE_VERSION}/docker-compose-linux-x86_64" \
  --output /usr/local/lib/docker/cli-plugins/docker-compose
printf '%s  %s\n' \
  "$${COMPOSE_SHA256}" \
  /usr/local/lib/docker/cli-plugins/docker-compose | sha256sum --check
chmod 0755 /usr/local/lib/docker/cli-plugins/docker-compose

install -d -m 0755 \
  "$${STACK_DIR}/grafana/provisioning/datasources" \
  "$${STACK_DIR}/grafana/provisioning/dashboards/json" \
  "$${STACK_DIR}/prometheus" \
  "$${STACK_DIR}/prometheus/rules" \
  "$${STACK_DIR}/alloy" \
  "$${STACK_DIR}/loki" \
  "$${STACK_DIR}/tempo"

write_config() {
  local destination="$1"
  local compressed="$2"
  printf '%s' "$compressed" | base64 --decode | gzip --decompress > "$destination"
  chmod 0644 "$destination"
}

write_config "$${STACK_DIR}/docker-compose.yml" "${compose_gzip}"
write_config "$${STACK_DIR}/prometheus/prometheus.yml" "${prometheus_gzip}"
write_config "$${STACK_DIR}/prometheus/rules/view-show.yml" "${prometheus_rules_gzip}"
write_config "$${STACK_DIR}/alloy/config.alloy" "${alloy_gzip}"
write_config "$${STACK_DIR}/loki/loki-config.yml" "${loki_gzip}"
write_config "$${STACK_DIR}/tempo/tempo.yml" "${tempo_gzip}"
write_config "$${STACK_DIR}/grafana/provisioning/datasources/datasources.yml" "${datasources_gzip}"
write_config "$${STACK_DIR}/grafana/provisioning/datasources/cloudwatch.yml" "${cloudwatch_datasource_gzip}"
write_config "$${STACK_DIR}/grafana/provisioning/dashboards/dashboards.yml" "${dashboard_provider_gzip}"
write_config "$${STACK_DIR}/grafana/provisioning/dashboards/json/view-show-aws.json" "${dashboard_gzip}"
write_config "$${STACK_DIR}/grafana/provisioning/dashboards/json/view-show-overview.json" "${application_dashboard_gzip}"

{
  printf 'GRAFANA_ADMIN_PASSWORD=%s\n' "$(printf '%s' '${grafana_password_base64}' | base64 --decode)"
  printf 'AWS_REGION=%s\n' '${aws_region}'
} > "$${STACK_DIR}/.env"
chmod 0600 "$${STACK_DIR}/.env"

cd "$${STACK_DIR}"
docker compose config --quiet
docker compose pull
docker compose up --detach --remove-orphans

# Indica ao runbook que o cloud-init terminou e a stack foi iniciada.
touch "$${STACK_DIR}/.provisioned"
