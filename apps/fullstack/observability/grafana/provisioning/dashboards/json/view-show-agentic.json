{
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "targets": [{ "expr": "sum by (event_type, status) (rate(analysis_messages_total[5m]))", "legendFormat": "{{event_type}} / {{status}}", "refId": "A" }],
      "title": "Analysis outcomes",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 0 },
      "id": 2,
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le, event_type) (rate(analysis_run_duration_seconds_bucket[5m])))", "legendFormat": "p50 {{event_type}}", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le, event_type) (rate(analysis_run_duration_seconds_bucket[5m])))", "legendFormat": "p95 {{event_type}}", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le, event_type) (rate(analysis_run_duration_seconds_bucket[5m])))", "legendFormat": "p99 {{event_type}}", "refId": "C" }
      ],
      "title": "Analysis duration p50/p95/p99",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "id": 3,
      "targets": [{ "expr": "sum by (provider, model_id, status) (rate(llm_requests_total[5m]))", "legendFormat": "{{provider}} / {{model_id}} / {{status}}", "refId": "A" }],
      "title": "LLM request outcomes",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 8 },
      "id": 4,
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le, provider, model_id) (rate(llm_request_duration_seconds_bucket[5m])))", "legendFormat": "p50 {{provider}} / {{model_id}}", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le, provider, model_id) (rate(llm_request_duration_seconds_bucket[5m])))", "legendFormat": "p95 {{provider}} / {{model_id}}", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le, provider, model_id) (rate(llm_request_duration_seconds_bucket[5m])))", "legendFormat": "p99 {{provider}} / {{model_id}}", "refId": "C" }
      ],
      "title": "LLM latency p50/p95/p99",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 5,
      "targets": [{ "expr": "sum by (model_id, token_type) (rate(llm_tokens_total[5m]))", "legendFormat": "{{model_id}} / {{token_type}}", "refId": "A" }],
      "title": "Token rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 6,
      "targets": [{ "expr": "sum by (model_id, stop_reason) (rate(llm_response_stop_total[5m]))", "legendFormat": "{{model_id}} / {{stop_reason}}", "refId": "A" }],
      "title": "Stop reasons",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 24 },
      "id": 7,
      "targets": [{ "query": "{ resource.service.name = \"view-show-agentic\" }", "queryType": "traceql", "refId": "A" }],
      "title": "Agentic traces",
      "type": "traces"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Available locally only when the worker runs in a container collected by Alloy.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 24 },
      "id": 8,
      "options": { "enableLogDetails": true, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [{ "expr": "{service_name=\"view-show-agentic\"} | json", "refId": "A" }],
      "title": "Agentic local logs",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["view-show", "agentic", "llm"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "View Show — Agentic LLM Observability",
  "uid": "view-show-agentic",
  "version": 1
}
