# Copy to terraform.tfvars and replace the administration role/CIDR.
deployment_namespace    = "view-show"
regiao                  = "us-east-1"
ambiente                = "learner-lab"
eks_admin_role_arn      = "arn:aws:iam::123456789012:role/operator"
eks_public_access_cidrs = ["192.0.2.1/32"]
kubernetes_version      = "1.35"
eks_node_instance_types = ["m6i.xlarge"]
eks_node_min_size       = 2
eks_node_max_size       = 6
eks_node_desired_size   = 2
api_replicas_minima     = 1
api_replicas_maxima     = 4
scheduler_ingestao_habilitado = false
live_sync_enabled            = false
incremental_s3_enabled       = false
analysis_worker_habilitado   = false
# Com o worker habilitado e sem Bedrock/Ollama, `rules` publica diagnósticos
# determinísticos ancorados nos fatos A′. O catálogo de fatos da ingestão
# precisa usar seriesIds `ts_<sha256>` (veja scope-catalog.pilot.json).
# analysis_llm_provider          = "rules"
# analysis_fact_catalog_location = "s3://<bucket-da-ingestao>/analysis/catalogs/<sha256>.json"

# AWS Academy alternative (learner-lab only; shared LabRole credentials).
# eks_iam_mode = "learner-lab-existing"
# eks_existing_cluster_role_arn = "arn:aws:iam::123456789012:role/LabEksClusterRole-NAME"
# eks_existing_node_role_arn = "arn:aws:iam::123456789012:role/LabRole"
# eks_existing_instance_profile = "LabInstanceProfile"
# eks_admin_role_arn = "arn:aws:iam::123456789012:role/voclabs"
# eks_node_instance_types = ["i3.large"]
# eks_node_root_volume_gib = 100
# eks_node_instance_store = true
