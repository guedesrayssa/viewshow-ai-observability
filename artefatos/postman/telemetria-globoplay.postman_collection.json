    {
      "name": "4. Ponta a ponta",
      "description": "A prova de que POST e GET conversam: um erro com código gerado na hora é enviado e, em seguida, localizado na consulta.",
      "item": [
        {
          "name": "4.1 Enviar erro com código único",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Código novo a cada execução, para que a verificação seguinte não",
                  "// possa ser satisfeita por dados de uma rodada anterior.",
                  "pm.collectionVariables.set('codigoE2E', 'TESTE_E2E_' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 202 Accepted', function () {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "",
                  "pm.test('O erro foi aceito', function () {",
                  "    pm.expect(pm.response.json().accepted).to.eql(1);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"session_id\": \"sess-e2e-postman\",\n  \"error_code\": \"{{codigoE2E}}\",\n  \"message\": \"verificação de ponta a ponta do relatório de testes\",\n  \"module\": \"player\",\n  \"service\": \"playback-api\",\n  \"fatal\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/v1/telemetry/errors",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "telemetry", "errors"]
            },
            "description": "Gera um código inédito antes de enviar. Sem isso, o teste seguinte poderia passar por causa de dados deixados por uma execução anterior."
          }
        },
        {
          "name": "4.2 Localizar o erro no ranking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const esperado = pm.collectionVariables.get('codigoE2E');",
                  "const codigos = pm.response.json().errors.map(function (item) {",
                  "    return item.error_code;",
                  "});",
                  "",
                  "pm.test('O erro enviado por POST aparece na consulta GET', function () {",
                  "    pm.expect(codigos).to.include(esperado);",
                  "});",
                  "",
                  "pm.test('Com exatamente uma ocorrência', function () {",
                  "    const item = pm.response.json().errors.find(function (e) {",
                  "        return e.error_code === esperado;",
                  "    });",
                  "    pm.expect(item.occurrences).to.eql(1);",
                  "    pm.expect(item.fatal_occurrences).to.eql(1);",
                  "    pm.expect(item.top_module).to.eql('player');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/v1/analytics/errors/top?window={{window}}&limit=200",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "analytics", "errors", "top"],
              "query": [
                { "key": "window", "value": "{{window}}" },
                { "key": "limit", "value": "200" }
              ]
            },
            "description": "Consulta o ranking completo e confirma que o código enviado na requisição anterior está lá, com a contagem, a marcação de fatal e o módulo corretos."
          }
        }
      ]
    }
