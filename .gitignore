# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/

# ---------- Node ----------
node_modules/
dist/
.vite/
npm-debug.log*

# ---------- Variáveis de ambiente ----------
# .env.example é versionado de propósito e não deve ser ignorado.
.env
.env.local
.env.*.local

# ---------- Ferramentas e sistema operacional ----------
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# ---------- AWS ----------
.aws-sam/
*.pem

# ---------- Terraform: caches, pacotes gerados e estado local ----------
.terraform/
.terraform-artifacts/
*.tfstate
*.tfstate.*
# .terraform.lock.hcl permanece versionado para fixar os providers.

# ---------- Dados e saídas brutas da pesquisa local ----------
/artefatos/arquitetura/estudos/resultados/**/*.sql
/artefatos/arquitetura/estudos/resultados/**/*.sql.gz
/artefatos/arquitetura/estudos/resultados/**/*.sqlite*
/artefatos/arquitetura/estudos/resultados/**/dataset.json
/artefatos/arquitetura/estudos/resultados/**/run-*.json
/artefatos/arquitetura/estudos/resultados/**/review-packets.json
/artefatos/arquitetura/estudos/resultados/**/review.html
/artefatos/arquitetura/estudos/resultados/**/sol-evaluation/blind/

# ---------- Laboratório Argus ----------
.worktrees/
/.claude/worktrees/
artefatos/extras/analysis/.ipynb_checkpoints/
artefatos/extras/analysis/**/.ipynb_checkpoints/
artefatos/extras/analysis/outputs/*
!artefatos/extras/analysis/outputs/.gitkeep

# ---------- Superpowers workflow artifacts ----------
*superpowers/
/docs/superpowers/
/.superpowers/
# Artefatos locais do worker analítico; modelos aprovados são publicados pelo pipeline, não pelo Git.
apps/backend/agentic/models/*.json
apps/backend/agentic/data/
